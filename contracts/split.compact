// Whisper Split — Level 3 Private Payroll & Payment Splits Contract (multi-pool)
//
// One deployed contract hosts many independent pools, each keyed by a random poolId: Bytes<32>.
//
// PUBLIC LEDGER STATE (per pool):
// - poolSharesRoot: Map<poolId, Field> (Merkle root committing to the pool's shares and identities)
// - poolDepositAmount: Map<poolId, Uint<128>> (Unshielded NIGHT the pool still holds in custody)
// - poolDistributionCount: Map<poolId, Uint<64>> (Successful claims from the pool)
// - claimed: Map<claimKey, Boolean> where claimKey = persistentHash([pad(32,"whisper-split:claim:v1"), poolId, participantId])
//
// PRIVATE WITNESSES:
// - getMyShare(): Uint<64> (Participant's private share amount)
// - getMySecretSalt(): Bytes<32> (Participant's private salt binding leaf to identity)
// - getMerkleProof(): MerkleTreePath<16, Bytes<32>> (Merkle membership proof)
//
// PRIVACY MODEL:
// - NIGHT is always unshielded, so balances and transfers are public by protocol design.
//   Individual share amounts stay private until the participant claims: the Merkle proof is
//   verified against private witnesses. Only a claim reveals that participant's own payout;
//   every other unclaimed share in every pool stays hidden.
pragma language_version 0.23.0;

import CompactStandardLibrary;

export ledger poolSharesRoot: Map<Bytes<32>, Field>;
export ledger poolDepositAmount: Map<Bytes<32>, Uint<128>>;
export ledger poolDistributionCount: Map<Bytes<32>, Uint<64>>;
export ledger claimed: Map<Bytes<32>, Boolean>;

witness getMyShare(): Uint<64>;
witness getMySecretSalt(): Bytes<32>;
witness getMerkleProof(): MerkleTreePath<16, Bytes<32>>;

pure circuit computeLeaf(participantId: Bytes<32>, share: Uint<64>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [participantId, salt, share as Field as Bytes<32>]
  );
}

// Composite claim key: domain-separated hash over BOTH poolId and participantId.
pure circuit computeClaimKey(poolId: Bytes<32>, participantId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "whisper-split:claim:v1"), poolId, participantId]
  );
}

export circuit deposit(poolId: Bytes<32>, amount: Uint<128>, root: Field): [] {
  const pid = disclose(poolId);
  assert(!poolSharesRoot.member(pid), "Pool already initialized");
  assert(amount > 0, "Deposit amount must be positive");
  receiveUnshielded(nativeToken(), disclose(amount));
  poolSharesRoot.insert(pid, disclose(root));
  poolDepositAmount.insert(pid, disclose(amount));
  poolDistributionCount.insert(pid, 0);
}

export circuit claim(poolId: Bytes<32>, participantId: Bytes<32>, recipient: UserAddress): [] {
  const pid = disclose(poolId);
  assert(poolSharesRoot.member(pid), "Pool does not exist");
  const pubId = disclose(participantId);
  assert(disclose(recipient.bytes) == pubId, "Recipient must match claimed identity");
  const claimKey = computeClaimKey(pid, pubId);
  assert(claimed.member(claimKey) == false || claimed.lookup(claimKey) == false, "Share already claimed");

  const share = getMyShare();
  const salt = getMySecretSalt();
  const leaf = computeLeaf(pubId, share, salt);
  const path = getMerkleProof();
  assert(path.leaf == leaf, "Merkle path leaf mismatch");

  const root = merkleTreePathRoot<16, Bytes<32>>(path);
  assert(poolSharesRoot.lookup(pid) == root.field, "Invalid Merkle proof for private share");

  const share128 = share as Uint<128>;
  const balance = poolDepositAmount.lookup(pid);
  assert(balance >= disclose(share128), "Insufficient pooled funds in contract");
  poolDepositAmount.insert(pid, disclose((balance - share128) as Uint<128>));

  sendUnshielded(nativeToken(), disclose(share128), right<ContractAddress, UserAddress>(disclose(recipient)));

  claimed.insert(claimKey, true);
  poolDistributionCount.insert(pid, (poolDistributionCount.lookup(pid) + 1) as Uint<64>);
}
